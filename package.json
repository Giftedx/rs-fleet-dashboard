{
  "name": "rs-fleet-dashboard",
  "description": "A RuneLite-style dashboard for a team of rs-sdk bots. Static site, no server.",
  "license": "BSD-2-Clause",
  "type": "module",
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "serve": "bun scripts/serve.ts",
    "demo": "bun scripts/make-demo.ts && bun scripts/serve.ts --data demo",
    "check-private": "bun scripts/check-private.ts",
    "deploy": "bun scripts/deploy.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "typescript": "5.8.3"
  }
}
